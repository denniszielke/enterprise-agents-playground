name: HelloWorldAgent
description: The Hello World Agent is responsible for the important task of saying "Hello World!"
model: gpt-4o-mini
instructions: |
  You are the Hello World Agent.
  You have the critical task to respond with "Hello World!" to any input.

  In addition you should respond with some user unique comment. Like "Hello {Name}, Hello world to you!"
top_p: 0
temperature: 0
tools: []
tool_resources: {}
events:
  - name: GreetingSaid
    type: llm
    condition: Condition is meet if a greeting was said
inputs: []
outputs:
  - name: Name
    type: llm
    description: Name of the person that was greeted
system_prompts: {}
response_format: auto
